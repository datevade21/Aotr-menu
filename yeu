<!DOCTYPE html>
<html lang="vi">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Cat Hub</title>
<style>
  :root {
    --bg: #fdf6e3;
    --card: #ffffff;
    --accent: #e07b39;
    --text: #2b2b2b;
    --muted: #8a8a8a;
    --error: #d64545;
    --success: #2e9e5b;
  }
  @media (prefers-color-scheme: dark) {
    :root:not([data-theme="light"]) {
      --bg: #1c1a17;
      --card: #2a2723;
      --text: #f2ece2;
      --muted: #a89f91;
    }
  }
  :root[data-theme="dark"] {
    --bg: #1c1a17;
    --card: #2a2723;
    --text: #f2ece2;
    --muted: #a89f91;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    min-height: 100vh;
    background: var(--bg);
    color: var(--text);
    font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .card {
    background: var(--card);
    border-radius: 20px;
    padding: 32px 24px;
    max-width: 420px;
    width: 100%;
    box-shadow: 0 10px 30px rgba(0,0,0,0.15);
    text-align: center;
  }
  h1 {
    margin: 0 0 4px;
    font-size: 28px;
    color: var(--accent);
  }
  p.sub {
    color: var(--muted);
    margin: 0 0 24px;
    font-size: 14px;
  }
  input[type="text"] {
    width: 100%;
    padding: 14px 16px;
    border-radius: 12px;
    border: 2px solid #e0d8c8;
    font-size: 16px;
    margin-bottom: 16px;
    outline: none;
    background: transparent;
    color: var(--text);
  }
  input[type="text"]:focus { border-color: var(--accent); }
  button {
    width: 100%;
    padding: 14px;
    border: none;
    border-radius: 12px;
    background: var(--accent);
    color: white;
    font-size: 16px;
    font-weight: 600;
    cursor: pointer;
  }
  button:disabled { opacity: 0.6; cursor: not-allowed; }
  .msg { margin-top: 14px; font-size: 14px; min-height: 20px; }
  .msg.error { color: var(--error); }
  .msg.success { color: var(--success); }
  .content-box {
    margin-top: 20px;
    padding: 18px;
    border-radius: 14px;
    background: rgba(224,123,57,0.1);
    text-align: left;
    white-space: pre-wrap;
    line-height: 1.5;
    display: none;
  }
</style>
</head>
<body>
  <div class="card">
    <h1>🐾 Cat Hub</h1>
    <p class="sub">Nhập mã key để mở nội dung</p>
    <input type="text" id="keyInput" placeholder="Nhập key tại đây...">
    <button id="submitBtn">Mở khoá</button>
    <div class="msg" id="msg"></div>
    <div class="content-box" id="contentBox"></div>
  </div>

<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-app-compat.js"></script>
<script src="https://www.gstatic.com/firebasejs/10.7.1/firebase-firestore-compat.js"></script>
<script>
  // ⚠️ THAY THẾ bằng config Firebase của bạn (lấy trong Firebase Console > Project Settings)
  const firebaseConfig = {
    apiKey: "YOUR_API_KEY",
    authDomain: "YOUR_PROJECT.firebaseapp.com",
    projectId: "YOUR_PROJECT_ID",
    storageBucket: "YOUR_PROJECT.appspot.com",
    messagingSenderId: "YOUR_SENDER_ID",
    appId: "YOUR_APP_ID"
  };

  firebase.initializeApp(firebaseConfig);
  const db = firebase.firestore();

  const keyInput = document.getElementById('keyInput');
  const submitBtn = document.getElementById('submitBtn');
  const msg = document.getElementById('msg');
  const contentBox = document.getElementById('contentBox');

  async function checkKey() {
    const key = keyInput.value.trim();
    if (!key) {
      msg.textContent = "Vui lòng nhập key.";
      msg.className = "msg error";
      return;
    }

    submitBtn.disabled = true;
    msg.textContent = "Đang kiểm tra...";
    msg.className = "msg";

    try {
      const doc = await db.collection('keys').doc(key).get();

      if (!doc.exists) {
        msg.textContent = "❌ Key không tồn tại.";
        msg.className = "msg error";
        contentBox.style.display = "none";
      } else {
        const data = doc.data();
        if (data.active === false) {
          msg.textContent = "❌ Key đã bị vô hiệu hoá.";
          msg.className = "msg error";
          contentBox.style.display = "none";
        } else {
          msg.textContent = "✅ Mở khoá thành công!";
          msg.className = "msg success";
          contentBox.textContent = data.content || "(Admin chưa set nội dung cho key này)";
          contentBox.style.display = "block";
        }
      }
    } catch (err) {
      msg.textContent = "Lỗi kết nối, thử lại sau.";
      msg.className = "msg error";
      console.error(err);
    }

    submitBtn.disabled = false;
  }

  submitBtn.addEventListener('click', checkKey);
  keyInput.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') checkKey();
  });
</script>
</body>
</html>
